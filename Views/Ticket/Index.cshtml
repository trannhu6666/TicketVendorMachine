@{
    ViewData["Title"] = "Mua Vé Metro";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            
            <div id="startScreen" class="card shadow-lg border-0 rounded-lg text-center" style="min-height: 450px;">
                <div class="card-body d-flex flex-column justify-content-center align-items-center p-5">
                    <h2 class="mb-3 text-primary fw-bold">CHÀO MỪNG ĐẾN VỚI BẾN THÀNH METRO</h2>
                    <p class="fs-5 text-muted mb-5">Vui lòng chạm vào màn hình để bắt đầu giao dịch</p>
                    
                    <button type="button" id="btnStart" class="btn btn-primary btn-lg py-4 px-5 fw-bold fs-3 rounded-pill shadow-sm">
                        👆 BẮT ĐẦU / START
                    </button>
                </div>
            </div>

            <div id="ticketFormScreen" class="card shadow-lg border-0 rounded-lg" style="display: none;">
                <div class="card-header bg-primary text-white text-center py-4 d-flex justify-content-between align-items-center">
                    <button type="button" id="btnBack" class="btn btn-outline-light btn-sm">&larr; Hủy</button>
                    <h3 class="mb-0 mx-auto">🚇 MÁY BÁN VÉ METRO</h3>
                    <div style="width: 45px;"></div>
                </div>
                <div class="card-body p-5">
                    <form asp-controller="Ticket" asp-action="BuyTicket" method="post">
                        
                        <div class="form-group mb-4">
                            <label class="fw-bold fs-5 mb-2">1. Chọn ga đến (Destination):</label>
                            <select name="stationId" class="form-select form-select-lg" required>
                                <option value="">-- Vui lòng chạm để chọn ga --</option>
                                @foreach (var item in ViewBag.Stations)
                                {
                                    <option value="@item.StationID">Ga @item.StationName - @item.BaseFare.ToString("N0") VNĐ</option>
                                }
                            </select>
                        </div>

                        <div class="form-group mb-5">
                            <label class="fw-bold fs-5 mb-2">2. Chọn phương thức thanh toán:</label>
                            <div class="d-flex justify-content-between">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="paymentMethod" id="momo" value="Momo" required>
                                    <label class="form-check-label fs-5" for="momo">Ví Momo</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="paymentMethod" id="vnpay" value="VNPay">
                                    <label class="form-check-label fs-5" for="vnpay">VNPay</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="paymentMethod" id="credit" value="CreditCard">
                                    <label class="form-check-label fs-5" for="credit">Thẻ tín dụng</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-lg py-3 fw-bold fs-4">
                                BẤM ĐỂ THANH TOÁN
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var startScreen = document.getElementById("startScreen");
        var formScreen = document.getElementById("ticketFormScreen");
        var btnStart = document.getElementById("btnStart");
        var btnBack = document.getElementById("btnBack");

        btnStart.addEventListener("click", function () {
            startScreen.style.display = "none";
            formScreen.style.display = "block";
        });

        btnBack.addEventListener("click", function () {
            formScreen.style.display = "none";
            startScreen.style.display = "block";
            document.querySelector("form").reset();
        });
    });
</script>